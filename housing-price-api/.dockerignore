# ============================================================
# .dockerignore — Task 1 房价预测 API (Python)
# 排除开发环境产物，Dockerfile 自行 pip install
# ============================================================

# Python 字节码
__pycache__/
*.py[cod]
*.pyo

# 虚拟环境
.venv/
venv/
env/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# 文档
README.md

# 测试
tests/
test_*.py
*_test.py

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log

# 环境变量
.env
.env.*
