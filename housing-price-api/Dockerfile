# ============================================================
# Dockerfile — Housing Price Prediction API
#
# Single-stage build: model is trained OUTSIDE Docker via
# `python train.py`, and the resulting artifacts (joblib + json)
# are copied into the image at build time.
#
# Usage:
#   1. Train first:  cd housing-price-api && python train.py
#   2. Build + run:  docker compose up --build
# ============================================================

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install Python dependencies (layer cached unless requirements change)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app/ ./app/

# Copy pre-trained model artifacts (generated by `python train.py`)
COPY models/ ./models/

# Expose API port
EXPOSE 8000

# Start FastAPI with uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
