# ============================================================
# .dockerignore — Next.js Portal 前端
# 排除本地产物，由 Dockerfile 在容器内自行构建
# ============================================================

# 依赖（Dockerfile 中 npm ci 安装）
node_modules/

# 构建产物（Dockerfile 中 npm run build 生成）
.next/

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo

# 文档/配置（不需要打入镜像的）
AGENTS.md
CLAUDE.md
README.md

# 环境变量（通过 docker-compose.yml 注入）
.env
.env.local
.env.development
.env.production
.env*.local

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*
